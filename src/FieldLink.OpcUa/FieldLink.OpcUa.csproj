<Project Sdk="Microsoft.NET.Sdk">

  <!-- OPC UA 클라이언트: OPC Foundation 공식 Client SDK에 저수준 전송/보안 스택을 위임하고 세션·구독 계약을 직접 소유한다. -->
  <PropertyGroup>
    <TargetFrameworks>net48;netstandard2.1</TargetFrameworks>
    <RootNamespace>FieldLink.OpcUa</RootNamespace>
    <Version>0.1.0</Version>
    <Description>OPC UA (IEC 62541) 클라이언트. 보안 정책 강제, 세대 격리 세션 수명, 품질 보존 읽기/쓰기 및 유한 큐 구독 제공.</Description>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="..\Shared\Polyfills\IsExternalInit.cs" />
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Client" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FieldLink.OpcUa.Tests" />
  </ItemGroup>

</Project>
